{
  "name": "openclaw-desktop",
  "version": "0.7.0",
  "description": "OpenClaw Desktop — Electron shell around the portable config-server and gateway",
  "main": "main.js",
  "private": true,
  "author": "yu.ai",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "release": "electron-builder --mac --win --linux --publish always"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "ai.yu.openclaw",
    "productName": "OpenClaw",
    "copyright": "© 2026 yu.ai",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../config-server",
        "to": "config-server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../app/core",
        "to": "app/core",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../skills-cn",
        "to": "skills-cn",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../PORTABLE_VERSION",
        "to": "PORTABLE_VERSION"
      },
      {
        "from": "../OPENCLAW_VERSION",
        "to": "OPENCLAW_VERSION"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Development"
    },
    "publish": {
      "provider": "github",
      "owner": "yuluyangguang1",
      "repo": "openclaw-portable",
      "releaseType": "release"
    },
    "asar": true
  }
}