#!/bin/bash
# OpenClaw.app launcher — finds the portable folder this .app sits in
# and execs the existing Mac-Start.command. Designed to be portable:
# the .app bundle lives next to Mac-Start.command, app/, data/, etc.,
# and double-clicking it starts OpenClaw with all data on the same
# device (USB stick, external drive, anywhere).
#
# Bundle layout when running:
#   <PORTABLE_ROOT>/
#     OpenClaw.app/
#       Contents/
#         MacOS/
#           OpenClaw      ← this script ($0)
#     Mac-Start.command   ← what we exec (or system/Mac-Start.command)
#     app/
#     data/
#
# So from $0, ../../.. is the portable root — UNLESS macOS is running
# us via App Translocation, in which case ../../.. points into a
# random /private/var/folders/.../AppTranslocation/.../d/ tmp dir
# that doesn't contain the rest of the portable bundle. We detect
# that case and try to recover or, failing that, give the user the
# exact one-liner they need to fix it.

set -e

# Resolve the script's true path (handle symlinks like /Volumes mounts).
SOURCE="$0"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# BIN_DIR = .../OpenClaw.app/Contents/MacOS
# Portable root = BIN_DIR/../../..
PORTABLE_ROOT="$(cd "$BIN_DIR/../../.." && pwd)"

# ── App Translocation detection + recovery ───────────────────────────
# When macOS runs an unsigned/quarantined .app, it copies the bundle
# to /private/var/folders/.../AppTranslocation/.../d/ before launching.
# That isolates malware but breaks portable apps that need files next
# to themselves — exactly our case. The path always contains the
# literal "/AppTranslocation/" component.
#
# Recovery strategy:
#   1. Try to find the original .app via LaunchServices (lsregister).
#      If found, re-launch from there using `open` and exit. macOS
#      may translocate again, but if the user has run xattr -cr or
#      moved the bundle, the second run breaks the cycle.
#   2. If recovery fails, show a dialog with the exact xattr command
#      the user needs. AppleScript dialogs don't support clipboard
#      writes, so we copy the command to the clipboard ourselves
#      via pbcopy before showing the dialog.
if [[ "$PORTABLE_ROOT" == *"/AppTranslocation/"* ]]; then
  # Try to find the original location via lsregister's database.
  # Filter for our bundle id, then take the first non-translocated
  # path. lsregister output format varies; use a permissive grep.
  LSREG="/System/Library/Frameworks/CoreServices.framework/Versions/A/Frameworks/LaunchServices.framework/Support/lsregister"
  ORIG_APP=""
  if [ -x "$LSREG" ]; then
    ORIG_APP=$(
      "$LSREG" -dump 2>/dev/null \
        | grep -E "path:.*/OpenClaw\.app" \
        | grep -v "/AppTranslocation/" \
        | grep -v "/Trash/" \
        | head -1 \
        | sed -E 's/^.*path: *//; s/ *\(.*\)$//'
    )
  fi

  if [ -n "$ORIG_APP" ] && [ -d "$ORIG_APP" ]; then
    ORIG_ROOT="$(cd "$ORIG_APP/.." && pwd)"
    # Auto-clear quarantine on the original folder so this is the LAST
    # time translocation happens. xattr exits non-zero if there's
    # nothing to remove, which is fine.
    xattr -dr com.apple.quarantine "$ORIG_ROOT" 2>/dev/null || true
    # Re-launch from the original location. After xattr removal,
    # macOS won't translocate this run.
    if [ -f "$ORIG_ROOT/system/Mac-Start.command" ]; then
      /usr/bin/open -a Terminal "$ORIG_ROOT/system/Mac-Start.command"
      exit 0
    elif [ -f "$ORIG_ROOT/Mac-Start.command" ]; then
      /usr/bin/open -a Terminal "$ORIG_ROOT/Mac-Start.command"
      exit 0
    fi
    # Fall through to the dialog if Mac-Start.command is missing
    # even at the original location (broken install).
  fi

  # Recovery failed — guide the user. We need to give them the ACTUAL
  # path to their portable folder, not a hardcoded ~/Desktop or
  # ~/Downloads. Real users put OpenClawPortable on USB sticks, NAS
  # mounts, external drives, anywhere. App Translocation hid the
  # original path from us, but Spotlight has indexed it under our
  # bundle id, so mdfind can find it.
  REAL_APP=""
  if command -v mdfind >/dev/null 2>&1; then
    REAL_APP=$(
      mdfind "kMDItemCFBundleIdentifier == 'ai.yu.openclaw.portable'" 2>/dev/null \
        | grep -v "/AppTranslocation/" \
        | grep -v "/.Trash/" \
        | head -1
    )
  fi

  if [ -n "$REAL_APP" ] && [ -d "$REAL_APP" ]; then
    REAL_ROOT="$(cd "$REAL_APP/.." && pwd)"
    # Build a clean, single-line xattr command pointing at the actual
    # folder, with shell-safe quoting. The user pastes this into
    # Terminal verbatim and it works regardless of whether the
    # OpenClawPortable folder lives on Desktop, USB stick, NAS, etc.
    # Single-quote wrapping defends against spaces, special chars,
    # and Chinese path components.
    QUOTED_ROOT=$(printf "%s" "$REAL_ROOT" | sed "s/'/'\\\\''/g")
    FIX_CMD="xattr -cr '$QUOTED_ROOT'"
    echo "$FIX_CMD" | /usr/bin/pbcopy 2>/dev/null || true
    /usr/bin/osascript -e "display dialog \"OpenClaw 被 macOS 隔离启动了（App Translocation）\n\n这是 macOS 对未签名应用的默认安全行为，第一次启动时会发生。\n\n已自动定位到你的便携文件夹：\n$REAL_ROOT\n\n修复方法（任选其一）：\n\n方法 1：复制粘贴一行命令（推荐）\n  • 已自动复制修复命令到剪贴板\n  • 打开「终端」(Terminal.app) 粘贴回车\n  • 重新双击 OpenClaw.app\n\n方法 2：用「访达」拖动\n  • 把 OpenClawPortable 整个文件夹拖到桌面（或别处），再拖回 U 盘 / 原位置\n  • 重新双击 OpenClaw.app\n\n方法 3：右键打开 Mac-Start.command\n  • 在便携文件夹里右键点击 system/Mac-Start.command → 打开\n  • 不需要使用 OpenClaw.app\" buttons {\"OK\"} default button 1 with icon stop with title \"OpenClaw 启动失败\""
  else
    # Spotlight didn't find us — folder probably on a volume that
    # Spotlight doesn't index (some USB sticks have indexing disabled,
    # or .Spotlight-V100 was removed by the user). Fall back to the
    # generic instructions without a specific path.
    /usr/bin/osascript -e "display dialog \"OpenClaw 被 macOS 隔离启动了（App Translocation）\n\n这是 macOS 对未签名应用的默认安全行为，第一次启动时会发生。\n\n修复方法（任选其一）：\n\n方法 1：在终端运行 xattr 命令\n  • 打开「终端」(Terminal.app)\n  • 输入 xattr -cr 然后空格\n  • 把 OpenClawPortable 文件夹从访达拖进终端（自动填入路径）\n  • 回车\n  • 重新双击 OpenClaw.app\n\n方法 2：用「访达」拖动\n  • 把 OpenClawPortable 整个文件夹拖到桌面（或别处），再拖回原位置\n  • 重新双击 OpenClaw.app\n\n方法 3：右键打开 Mac-Start.command\n  • 在便携文件夹里右键点击 system/Mac-Start.command → 打开\n  • 不需要使用 OpenClaw.app\" buttons {\"OK\"} default button 1 with icon stop with title \"OpenClaw 启动失败\""
  fi
  exit 1
fi

# ── Normal path ──────────────────────────────────────────────────────
# Prefer the system/ subdirectory layout (release zip), fall back to
# the launcher being at the portable root (dev mode).
if [ -f "$PORTABLE_ROOT/system/Mac-Start.command" ]; then
    LAUNCHER="$PORTABLE_ROOT/system/Mac-Start.command"
else
    LAUNCHER="$PORTABLE_ROOT/Mac-Start.command"
fi

if [ ! -f "$LAUNCHER" ]; then
  /usr/bin/osascript -e "display dialog \"OpenClaw 启动失败：找不到 Mac-Start.command\n\n请把 OpenClaw.app 放在 OpenClawPortable 目录下（与 Mac-Start.command 同级），不要单独移动。\n\n查找路径：\n$LAUNCHER\" buttons {\"OK\"} default button 1 with icon stop with title \"OpenClaw\""
  exit 1
fi

# Open Terminal.app to run Mac-Start.command so users see logs and
# can Ctrl+C. This matches the existing portable double-click UX
# while letting the .app be the entry point.
/usr/bin/open -a Terminal "$LAUNCHER"
