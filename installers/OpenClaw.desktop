[Desktop Entry]
Version=1.0
Type=Application
Name=OpenClaw
Comment=Portable AI agent — data lives where this app lives
GenericName=AI Agent
Exec=bash -c 'D="$(cd "$(dirname "%k")" && pwd)"; if [ "$(basename "$D")" = "system" ]; then D="$(dirname "$D")"; fi; bash "$D/system/Linux-Start.sh"'
Path=
Icon=openclaw
Terminal=true
Categories=Development;Utility;
Keywords=AI;LLM;Agent;Chat;
StartupNotify=true
