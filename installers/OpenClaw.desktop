[Desktop Entry]
Version=1.0
Type=Application
Name=OpenClaw
Comment=Portable AI agent — data lives where this app lives
GenericName=AI Agent
Exec=bash -c 'D="$(dirname "%k")"; if [ -f "$D/system/Linux-Start.sh" ]; then bash "$D/system/Linux-Start.sh"; else bash "$D/Linux-Start.sh"; fi'
Path=
Icon=openclaw
Terminal=true
Categories=Development;Utility;
Keywords=AI;LLM;Agent;Chat;
StartupNotify=true
